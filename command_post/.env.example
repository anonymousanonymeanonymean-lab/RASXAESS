# =====================================================
# COMMAND POST — Environment
# Copy to .env and fill in real values.
# =====================================================

# ---- Mission ----
CP_MISSION_ID=mission_default
CP_MISSION_NAME=ONA Demo Mission
CP_ENVIRONMENT=urban_sar

# ---- Backend ----
CP_API_HOST=0.0.0.0
CP_API_PORT=8000
CP_DB_PATH=./data/command_post.db
CP_LOG_LEVEL=INFO
CP_CORS_ORIGINS=http://localhost:5173

# ---- MQTT ----
CP_MQTT_ENABLED=true
MQTT_BROKER=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT=
MQTT_CLIENT_ID=command-post-01
MQTT_QOS=1
MQTT_TLS=true

# ---- Aging (seconds) ----
CP_AGING_NEW_SECONDS=10
CP_AGING_ACTIVE_SECONDS=60
CP_AGING_RECENT_SECONDS=300
CP_AGING_STALE_SECONDS=900