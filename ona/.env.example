# =====================================================
# ONA v1.0 — Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# =====================================================

# ---------- Mission ----------
ONA_MISSION_ID=mission_default
ONA_ENVIRONMENT=urban_sar
ONA_LOG_LEVEL=INFO

# ---------- Radio (SX1262 via ESP32 USB/UART) ----------
ONA_RADIO_BACKEND=simulated
ONA_RADIO_PORT=/dev/ttyUSB0
ONA_RADIO_BAUDRATE=115200
ONA_RADIO_FREQUENCY_HZ=868000000
ONA_RADIO_BANDWIDTH_HZ=125000
ONA_RADIO_SPREADING_FACTOR=9
ONA_RADIO_CODING_RATE=5
ONA_RADIO_TX_POWER_DBM=14

# ---------- Database ----------
ONA_DB_PATH=./data/ona.db

# ---------- MQTT over TLS ----------
ONA_MQTT_ENABLED=true
MQTT_HOST=
MQTT_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_CERT=
MQTT_CLIENT_ID=ona-01
MQTT_QOS=1
MQTT_KEEPALIVE=60

# ---------- Outbox ----------
ONA_OUTBOX_MAX_RETRIES=10
ONA_OUTBOX_BACKOFF_BASE_SECONDS=2
ONA_OUTBOX_BACKOFF_MAX_SECONDS=300
ONA_OUTBOX_TTL_SECONDS=86400

# ---------- Stale data policy ----------
ONA_MAX_MESSAGE_AGE_SECONDS=3600

# ---------- REST API ----------
ONA_API_HOST=127.0.0.1
ONA_API_PORT=8000